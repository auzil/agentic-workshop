  "description": "Hands-on workshop series: building agentic AI systems with TypeScript and Azure OpenAI.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ws:01": "node --env-file=.env --import tsx workshops/01-agent-loop/starter.ts",
